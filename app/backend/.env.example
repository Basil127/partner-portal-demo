# Backend Environment Variables
# Copy to .env.local for local development or .env.production for production

# App
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ohm_backend
DB_USER=postgres
DB_PASSWORD=password

# Security — CHANGE THESE in real environments
JWT_SECRET=change-me-jwt-secret
SESSION_SECRET=change-me-session-secret

# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# External mock API
EXTERNAL_CLIENT_BASE_URL=http://localhost:8000
EXTERNAL_CLIENT_CHANNEL_CODE=demo-channel
EXTERNAL_CLIENT_APP_KEY=
EXTERNAL_CLIENT_ORIGINATING_APP=
EXTERNAL_CLIENT_EXTERNAL_SYSTEM=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
