# Frontend - example configuration file
#
# Leave NEXT_PUBLIC_API_URL empty — browsers use relative URLs (/api/*) which
# Next.js rewrites server-side to BACKEND_INTERNAL_URL. This eliminates CORS
# and Private Network Access issues regardless of the public IP or domain.
NEXT_PUBLIC_API_URL=

# Internal backend URL used by the Next.js server process (not the browser).
# Uses the Docker Compose service name so traffic stays inside the Docker network.
BACKEND_INTERNAL_URL=http://backend:3001
