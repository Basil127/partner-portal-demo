{
	"name": "partner-portal-demo",
	"version": "0.1.0",
	"description": "A Demo of a B2B Partner portal for booking management",
	"private": true,
	"type": "module",
	"workspaces": [
		"app/backend",
		"app/frontend",
		"packages/shared"
	],
	"scripts": {
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:mock-api\"",
		"dev:backend": "npm run dev --workspace=app/backend",
		"dev:frontend": "npm run dev --workspace=app/frontend",
		"dev:mock-api": "cd app/mock-api && uv run -m operaclone2",
		"build": "npm run build --workspaces",
		"build:backend": "npm run build --workspace=app/backend",
		"build:frontend": "npm run build --workspace=app/frontend",
		"test": "npm run test --workspace=app/backend",
		"test:unit": "npm run test --workspace=app/backend",
		"pre-commit": "npm run lint && npm run typecheck && npm run format",
		"lint": "concurrently \"eslint app/backend --ext .ts\" \"eslint app/frontend --ext .ts,.tsx\" \"eslint packages/shared --ext .ts\"",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write app/frontend app/backend packages/shared",
		"format:check": "prettier --check app/frontend app/backend packages/shared",
		"typecheck": "tsc -p app/backend/tsconfig.json --noEmit && tsc -p app/frontend/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.json --noEmit",
		"openapi:generate": "npm run generate:openapi --workspace=app/backend && npm run generate:client --workspace=app/backend && npm run generate:client --workspace=app/frontend"
	},
	"devDependencies": {
		"@hey-api/client-fetch": "^0.13.1",
		"@hey-api/openapi-ts": "^0.90.4",
		"@typescript-eslint/eslint-plugin": "^8.20.0",
		"@typescript-eslint/parser": "^8.20.0",
		"concurrently": "^9.1.2",
		"env-cmd": "^11.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.1.8",
		"openapi-types": "^12.1.3",
		"prettier": "^3.6.2",
		"shadcn": "^3.8.5",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	}
}
