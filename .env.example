# =============================================================================
# Shared environment — used by Caddy, frontend, and backend
# =============================================================================
# Copy this file to .env, fill in values, and NEVER commit the filled-in file.
# Docker Compose reads .env from the project root automatically, so all
# ${VARIABLE} references in any docker-compose*.yml are substituted from here.
#
# -----------------------------------------------------------------------------

# Public hostname Caddy serves.
#   Local  → localhost  (Caddy uses its internal CA, no real cert needed)
#   VPS    → your real domain, e.g. demo.example.com
DOMAIN=localhost

# Let's Encrypt / ZeroSSL registration email.
# Leave blank locally. Set on your VPS so you get cert-expiry notifications.
ACME_EMAIL=

# Docker image version tag applied to all services.
# Use a specific tag (e.g. 1.2.0) in production to pin exact builds.
VERSION=latest

# Backend API base URL seen by the browser.
# Leave empty → Next.js rewrites relative /api/* calls to the backend
# internally (recommended). Only set if the browser must hit the backend
# directly (e.g. a separate domain / port).
NEXT_PUBLIC_API_URL=
